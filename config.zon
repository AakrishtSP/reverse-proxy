.{
    .listen = 8880,
    .server = .{
        .kind = .epoll,
        .epoll = .{
            .client_keepalive = true,
            .backend_keepalive = true,
            .chunked_requests = true,
            .pool_size = 100,
        },
    },
    .vhosts = .{
        .{
            .hostnames = .{"jellyfin.internal"},
            .backends = .{"127.0.0.1:8000"},
        },
    },
    .default_backends = .{"127.0.0.1:8888"},
}